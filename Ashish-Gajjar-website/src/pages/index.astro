---
import "../Style/global.css";
import "../Style/home-card.css";
import HomeCard from "../components/HomeCard.astro";

const cards = [
	{
		eyebrow: "Home",
		title: "Space",
		intro: ["Hello,", "I am Ashish Gajjar,", "& this is my web"],
		tagline: ["Living archive of ideas,", "pursuit of Better Design."],
	},
	{
		eyebrow: "Work",
		title: "Rhythm",
		intro: ["Selected work,", "shaping motion,", "layout, and flow"],
		tagline: ["A focused collection of", "visual experiments."],
	},
	{
		eyebrow: "Notes",
		title: "Form",
		intro: ["Ideas in progress,", "refined through", "spacing and contrast"],
		tagline: ["Simple systems with", "a strong graphic edge."],
	},
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ashish Gajjar's Portfolio</title>
  </head>
  <body>
	    <main class="frame">
			<section class="scroller" aria-label="Horizontal portfolio cards">
				<div class="scroller__viewport" data-scroller-viewport>
					<div class="scroller__track" data-scroller-track>
						<div class="scroller__group" data-scroller-group>
							{cards.map((card) => <HomeCard {...card} />)}
						</div>
						<div class="scroller__group" aria-hidden="true">
							{cards.map((card) => <HomeCard {...card} />)}
						</div>
					</div>
				</div>
			</section>
    </main>

		<script is:inline>
			const viewport = document.querySelector("[data-scroller-viewport]");
			const track = document.querySelector("[data-scroller-track]");
			const firstGroup = document.querySelector("[data-scroller-group]");
			const cards = document.querySelectorAll(".card");

			if (viewport && track && firstGroup) {
				let groupWidth = 0;
				let isSyncing = false;
				let frameId = 0;

				const setLoopPosition = () => {
					groupWidth = firstGroup.getBoundingClientRect().width;
					if (groupWidth > 0) {
						viewport.scrollLeft = groupWidth;
					}
				};

				const updateCardPerspective = () => {
					frameId = 0;

					if (!cards.length) {
						return;
					}

					const viewportRect = viewport.getBoundingClientRect();
					const viewportCenter = viewportRect.left + viewportRect.width / 2;

					cards.forEach((card) => {
						const rect = card.getBoundingClientRect();
						const cardCenter = rect.left + rect.width / 2;
						const offset = (cardCenter - viewportCenter) / (viewportRect.width / 2 || 1);
						const distance = Math.min(1, Math.abs(offset));
						const direction = offset < 0 ? 1 : -1;
						const rotateY = direction * distance * 18;
						const scale = 1 - distance * 0.08;

						card.style.setProperty("--card-rotate", `${rotateY}deg`);
						card.style.setProperty("--card-scale", scale.toFixed(3));
					});
				};

				const requestCardPerspectiveUpdate = () => {
					if (frameId) {
						return;
					}

					frameId = window.requestAnimationFrame(updateCardPerspective);
				};

				const wrapScroll = () => {
					if (isSyncing || groupWidth === 0) {
						return;
					}

					if (viewport.scrollLeft <= 0) {
						isSyncing = true;
						viewport.scrollLeft = groupWidth;
						isSyncing = false;
						return;
					}

					if (viewport.scrollLeft >= groupWidth * 2 - viewport.clientWidth) {
						isSyncing = true;
						viewport.scrollLeft = groupWidth;
						isSyncing = false;
					}
				};

				setLoopPosition();
				requestCardPerspectiveUpdate();
				window.addEventListener("load", setLoopPosition);
				window.addEventListener("resize", setLoopPosition);
				viewport.addEventListener("scroll", () => {
					wrapScroll();
					requestCardPerspectiveUpdate();
				}, { passive: true });

				if (typeof ResizeObserver !== "undefined") {
					const observer = new ResizeObserver(setLoopPosition);
					observer.observe(track);
					observer.observe(firstGroup);
					observer.observe(viewport);
				}
			}
		</script>
  </body>
</html>
